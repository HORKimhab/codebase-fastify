APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
# LOG_LEVEL options: trace | debug | info | warn | error | fatal
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_MAX_TIMEOUT_MS=60000

# Mail
MAIL_TRANSPORT=google
# or
# MAIL_TRANSPORT=ses

# --- Google SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# --- AWS SES ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxx
AWS_SECRET_ACCESS_KEY=xxxx

MAIL_FROM="Fastify App <no-reply@gmail.com>"

# Swagger docs auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_this_password
SECRET_45=your_secret_value_45
